FROM python:3.12-slim

# Create unprivileged sandbox user
RUN groupadd -g 1000 sandboxuser && \
    useradd -m -u 1000 -g sandboxuser -s /bin/bash sandboxuser

# Install safe data science & plotting libraries
RUN pip install --no-cache-dir \
    pandas==2.2.1 \
    numpy==1.26.4 \
    matplotlib==3.8.3 \
    seaborn==0.13.2

# Set unprivileged user
USER sandboxuser
WORKDIR /workspace

ENV MPLBACKEND=Agg
ENV PYTHONUNBUFFERED=1

CMD ["python3", "-c", "print('Vultr BlastShield Sandbox Ready')"]
