# ==========================================
# Vultr BlastShield Environment Configuration
# ==========================================

# Vultr Serverless Inference API
# Get your API key from my.vultr.com -> Serverless Inference
VULTR_INFERENCE_API_KEY=your_vultr_inference_api_key_here
VULTR_INFERENCE_ENDPOINT=https://api.vultrinference.com/v1
VULTR_INFERENCE_MODEL=llama-3.3-70b-instruct

# Sandbox Settings
SANDBOX_BACKEND=auto           # 'auto', 'docker', or 'subprocess'
SANDBOX_TIMEOUT_SECONDS=10     # Maximum execution time per run
SANDBOX_MEMORY_LIMIT_MB=256    # Memory cap
SANDBOX_CPU_QUOTA=0.5          # Max CPU cores

# Backend Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Demo & Simulation Mode
# When True, if Vultr API Key is missing, uses built-in smart mock responses
ENABLE_SMART_FALLBACK=true
